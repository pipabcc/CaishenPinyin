<Window x:Class="ShuruSettings.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="确认操作" Width="430" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Background="#FFFFFF"
        ShowInTaskbar="False" UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="12"
                        GlassFrameThickness="0" ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border CornerRadius="12" Background="#FFFFFF"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          Padding="24,22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}"/>

      <Grid Grid.Row="1" Margin="0,14,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14"
                Background="{StaticResource PrimarySoftBrush}"
                VerticalAlignment="Top">
          <TextBlock Text="!" Foreground="{StaticResource PrimaryBrush}"
                     FontWeight="Bold" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="DialogMessage" Grid.Column="1"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14" LineHeight="22" TextWrapping="Wrap"
                   VerticalAlignment="Top"/>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Content="取消" Width="92" IsCancel="True"
                Click="Cancel_Click"/>
        <Button x:Name="ConfirmButton" Content="确认" Width="104"
                Margin="12,0,0,0" IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="Confirm_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

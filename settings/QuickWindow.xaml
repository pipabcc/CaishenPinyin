<Window x:Class="ShuruSettings.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记录窗口" Width="340" Height="540"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated">

  <Window.Resources>
    <!-- 浅色质感颜色与笔刷，与设置页面右侧完全一致 -->
    <SolidColorBrush x:Key="QuickBgBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#EDF2F9"/>
    <SolidColorBrush x:Key="DeleteRedBrush" Color="#EF4444"/>

    <!-- 列表项样式：紧凑行距，与候选弹窗一致 -->
    <Style x:Key="QuickItemContainerStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" CornerRadius="5" Background="Transparent"
                    Padding="8,3" MinHeight="28">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBgBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <!-- 主卡片容器：浅色圆角阴影 -->
    <Border CornerRadius="10" Background="{StaticResource QuickBgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseDown">
      <Border.Effect>
        <DropShadowEffect Color="#0F172A" BlurRadius="20" Opacity="0.18" ShadowDepth="4" Direction="270"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <!-- 标题栏 -->
          <RowDefinition Height="38"/>
          <!-- 搜索栏 -->
          <RowDefinition Height="40"/>
          <!-- 列表内容区 -->
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 (可拖动) -->
        <Grid Grid.Row="0" Margin="14,4,8,0">
          <TextBlock x:Name="TitleBlock" Text="复制记录"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- 最小化按钮 -->
            <Button Width="26" Height="26" Style="{StaticResource ModernTextButtonStyle}"
                    Foreground="{StaticResource TextMutedBrush}" Content="一" FontSize="11"
                    Click="Minimize_Click" ToolTip="最小化"/>
            <!-- 关闭按钮 -->
            <Button Width="26" Height="26" Style="{StaticResource ModernTextButtonStyle}"
                    Foreground="{StaticResource TextMutedBrush}" Content="✕" FontSize="12"
                    Click="Close_Click" ToolTip="关闭"/>
          </StackPanel>
        </Grid>

        <!-- 搜索输入框 -->
        <Grid Grid.Row="1" Margin="14,2,14,4">
          <Border CornerRadius="6" Background="{StaticResource CardBgBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
              <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                       Padding="8,4" VerticalAlignment="Center"
                       TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
              <TextBlock x:Name="SearchPlaceholder" Text="搜索记录内容..."
                         Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                         Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </Grid>

        <!-- 记录列表 -->
        <Grid Grid.Row="2" Margin="6,2,6,8">
          <ListBox x:Name="RecordListBox" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource QuickItemContainerStyle}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   PreviewKeyDown="RecordListBox_PreviewKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid x:Name="ItemGrid" Background="Transparent"
                      MouseLeftButtonUp="Item_Click" Cursor="Hand">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                  </Grid.ColumnDefinitions>

                  <!-- 圆点图标 • -->
                  <TextBlock Grid.Column="0" Text="•" Foreground="#64748B"
                             FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>

                  <!-- 文本标题 (固定宽度，绝不动来动去) -->
                  <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="12.5" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip="{Binding Content}"/>

                  <!-- 简约美观的矢量垃圾桶删除按钮（鼠标悬停透明度变为1） -->
                  <Button x:Name="DeleteBtn" Grid.Column="2" Width="22" Height="22"
                          Background="Transparent" BorderThickness="0"
                          Foreground="#94A3B8"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                          Opacity="0"
                          Click="DeleteItem_Click" ToolTip="删除记录">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="Transparent">
                                <Path Data="M3,5 H13 M5,5 V13 C5,13.5 5.5,14 6,14 H10 C10.5,14 11,13.5 11,13 V5 M7,5 V3.5 C7,3.2 7.2,3 7.5,3 H8.5 C8.8,3 9,3.2 9,3.5 V5 M6.5,7.5 V11.5 M9.5,7.5 V11.5"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Foreground" Value="#EF4444"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
                <DataTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteBtn" Property="Opacity" Value="1"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空记录提示 -->
          <TextBlock x:Name="EmptyHint" Text="暂无记录"
                     Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window x:Class="ShuruSettings.EditClipboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="编辑剪贴板内容" Width="480" Height="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="False"
        Background="#FFFFFF" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="12"
                        GlassFrameThickness="0" ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border CornerRadius="12" Background="#FFFFFF"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题栏 -->
      <TextBlock Grid.Row="0" Text="编辑记录内容" FontSize="16" FontWeight="SemiBold"
                 Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

      <!-- 编辑框 -->
      <TextBox x:Name="ContentEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" FontSize="13" Padding="8"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
               Background="#F8FAFC" Foreground="{StaticResource TextPrimaryBrush}"
               TextOptions.TextFormattingMode="Display"
               TextOptions.TextRenderingMode="ClearType"/>

      <!-- 底部按钮 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="取消" Width="80" Height="32" Click="Cancel_Click"/>
        <Button Content="保存" Width="90" Height="32" Margin="12,0,0,0"
                 Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

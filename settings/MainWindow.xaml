                            <!-- 行 1: F9 -->
                            <Border Grid.Row="1" Grid.Column="0" Padding="14,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                              <Border Background="#EEF2F6" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="F9" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                              </Border>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Padding="14,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                              <TextBlock Text="打开 / 关闭软键盘（Soft Keyboard）" TextWrapping="Wrap"/>
                            </Border>

                            <!-- 行 2: 鼠标右键单击候选框 -->
                            <Border Grid.Row="2" Grid.Column="0" Padding="14,8">
                              <Border Background="#EEF2F6" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="鼠标右键单击候选框" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                              </Border>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Padding="14,8">
                              <TextBlock Text="唤起输入法上下文菜单（进入输入法设置、切换皮肤、词库管理等）" TextWrapping="Wrap"/>
                            </Border>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>

                  </StackPanel>
                </ScrollViewer>
              </Grid>

            </Grid>

            <!-- ================= 底部状态与操作栏 (右下 12px 圆角) ================= -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,0" Padding="28,14,48,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource PrimaryBrush}"
                           FontSize="12" AutomationProperties.LiveSetting="Polite"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="打开输入法安装文件夹"
                           MouseLeftButtonUp="StatusText_MouseLeftButtonUp"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="关闭" Width="88" Click="Close_Click"/>
                  <Button Content="保存设置" Width="110" Margin="12,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

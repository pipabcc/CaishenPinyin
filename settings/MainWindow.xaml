<Window x:Class="ShuruSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="财神输入法设置" Width="1120" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Icon="app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown">

  <!-- 外层留出 18px 留白专门渲染高级弥散阴影，保证圆角与阴影不被窗口边界裁切 -->
  <Grid Margin="18">
    <!-- 主圆角浮空卡片 -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBgBrush}"
            BorderThickness="0">
      <Border.Effect>
        <DropShadowEffect Color="#0B132B" BlurRadius="24" Opacity="0.22" ShadowDepth="4" Direction="270"/>
      </Border.Effect>

      <Grid>
        <Grid.ColumnDefinitions>
          <!-- 侧边栏宽度 240px -->
          <ColumnDefinition Width="240"/>
          <!-- 主内容区 -->
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 侧边栏 (左上/左下 12px 圆角) ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                CornerRadius="12,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌标题区域 -->
            <StackPanel Margin="24,28,20,12">
              <TextBlock Text="财神输入法" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="输入法设置" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 导航菜单 -->
            <ListBox x:Name="NavigationList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="12,22,12,0" SelectedIndex="0"
                     SelectionChanged="NavigationList_SelectionChanged">
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="常规设置"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="输入方案"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="自定义短语"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="剪贴板"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="词库与隐私"/>
            </ListBox>

            <!-- 侧边栏底部版本信息 -->
            <StackPanel Grid.Row="2" Margin="20,16,20,20">
              <Border Height="1" Background="#2E3542" Margin="0,0,0,16"/>
              <TextBlock Text="2.0.1" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12"/>
              <TextBlock Text="本地运行 · 数据归您所有" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================= 主区域 (右上/右下 12px 圆角) ================= -->
        <Border Grid.Column="1" Background="{StaticResource AppBgBrush}"
                CornerRadius="0,12,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <!-- 顶部内容展示区 -->
              <RowDefinition Height="*"/>
              <!-- 底部操作与状态栏 -->
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 右上角自定义关闭按钮 -->
            <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,20,0" Panel.ZIndex="30"
                    ToolTip="关闭窗口" Click="Close_Click"/>

            <!-- 页面内容统一容器：左右留白舒适，与图2一致 -->
            <Grid Grid.Row="0" Margin="44,28,40,16">

              <!-- 1. 常规设置页面 -->
              <Grid x:Name="GeneralPage">
                <Grid.RowDefinitions>
                  <!-- 固定的页面头部：与自定义短语在同一高度 -->
                  <RowDefinition Height="Auto"/>
                  <!-- 下方卡片滚动区 -->
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="常规设置" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="调整启动状态、候选数量和中文标点。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,40,16">
                    <!-- 卡片 1: 启动与输入 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="启动与输入" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="控制输入法每次激活后的默认状态。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <CheckBox x:Name="EnglishDefaultBox" Content="启动后默认使用英文模式" Margin="0,16,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 2: 输入法列表名称 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock x:Name="DisplayNameLabel" Text="输入法列表名称" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="显示在 Windows 输入法切换列表中；任务栏的语言名称“简体”由系统管理。"
                                   Style="{StaticResource SectionDescriptionStyle}"/>
                        <TextBox x:Name="DisplayNameBox" MaxLength="24" Width="320"
                                 HorizontalAlignment="Left" Margin="0,16,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DisplayNameLabel}"
                                 AutomationProperties.HelpText="输入一至二十四个可见字符"/>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 3: 候选窗口 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="候选窗口" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="设置每页显示数量与候选文字大小。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <WrapPanel Margin="0,16,0,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                            <TextBlock Text="每页候选数量" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="CandidateCountBox" Width="96" SelectedValuePath="Content">
                              <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                              <ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                              <ComboBoxItem Content="9"/><ComboBoxItem Content="11"/>
                            </ComboBox>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="候选字体大小" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="CandidateFontSizeBox" Width="96" SelectedValuePath="Content">
                              <ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/>
                              <ComboBoxItem Content="19"/><ComboBoxItem Content="20"/><ComboBoxItem Content="22"/>
                              <ComboBoxItem Content="24"/><ComboBoxItem Content="26"/><ComboBoxItem Content="28"/>
                              <ComboBoxItem Content="30"/><ComboBoxItem Content="32"/>
                            </ComboBox>
                          </StackPanel>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 4: 中文标点 (圆角 8px 与输入框对齐) -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="中文标点" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="选择中文模式下标点符号的输出方式。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <RadioButton x:Name="FullWidthBox" Content="中文标点（，。！）" GroupName="Punctuation"
                                       Style="{StaticResource SegmentRadioStyle}" Margin="0,0,12,0"/>
                          <RadioButton x:Name="HalfWidthBox" Content="英文标点（,.!）" GroupName="Punctuation"
                                       Style="{StaticResource SegmentRadioStyle}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 5: 关于 (注: 保持清爽，无性能与体验卡片) -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="财神输入法 2.0.1 · 本地运行，数据归您所有。" Style="{StaticResource SectionDescriptionStyle}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

              <!-- 2. 输入方案页面 -->
              <Grid x:Name="InputPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="输入方案" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="选择拼音输入方式，并配置容错规则。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,40,16">
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="拼音模式" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="更改后保存，重新切换到本输入法即可生效。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <RadioButton x:Name="QuanpinBox" Content="全拼" GroupName="InputSchema"
                                       Style="{StaticResource SegmentRadioStyle}" Margin="0,0,12,0"/>
                          <RadioButton x:Name="ShuangpinBox" Content="双拼（小鹤方案）" GroupName="InputSchema"
                                       Style="{StaticResource SegmentRadioStyle}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="模糊拼音" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="输入不准确时仍尝试恢复合理候选。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <CheckBox x:Name="FuzzyEnabledBox" Content="启用模糊拼音" Margin="0,16,0,4"
                                  Checked="FuzzyEnabled_Changed" Unchecked="FuzzyEnabled_Changed"/>
                        <StackPanel x:Name="FuzzyChildren" Margin="24,10,0,0">
                          <CheckBox x:Name="FuzzyInitialsBox" Content="声母容错，例如 zh / z、n / l" Margin="0,4,0,0"/>
                          <CheckBox x:Name="FuzzyFinalsBox" Content="韵母容错，例如 ang / an" Margin="0,8,0,0"/>
                          <CheckBox x:Name="FuzzyMissingVowelBox" Content="漏元音恢复" Margin="0,8,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

              <!-- 3. 自定义短语页面 -->
              <Grid x:Name="PhrasePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="自定义短语" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="让常用地址、签名或固定文本按输入码出现在指定候选位置。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="320" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox x:Name="PhraseSearchBox" Padding="12,0,40,0"
                             VerticalContentAlignment="Center"
                             ToolTip="搜索输入码或短语"
                             TextChanged="PhraseSearchBox_TextChanged"/>
                    <Button x:Name="PhraseSearchButton"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            IsTabStop="False" ToolTip="搜索"
                            Click="PhraseSearchButton_Click">
                      <Viewbox Width="15" Height="15">
                        <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 6.5,12 A 5.5,5.5 0 1 1 6.5,1 M 10.5,10.5 L 15,15"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"/>
                      </Viewbox>
                    </Button>
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="添加短语" Style="{StaticResource PrimaryButtonStyle}" Click="AddPhrase_Click"/>
                    <Button Content="编辑" Margin="10,0,0,0" Click="EditPhrase_Click"/>
                    <Button Content="删除" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeletePhrase_Click"/>
                  </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PhraseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0"
                              MouseDoubleClick="PhraseGrid_MouseDoubleClick">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="输入码" Binding="{Binding Code}" Width="150"
                                            ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                            HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}"/>
                        <DataGridTextColumn Header="候选位置" Binding="{Binding Position}" Width="110"
                                            ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                            HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}"/>
                        <DataGridTextColumn Header="短语内容" Binding="{Binding Phrase}" Width="*"
                                            ElementStyle="{StaticResource DataGridTextStyle}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="18,14" Background="#FFFFFF">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PhraseCountText" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox x:Name="PhraseDirectWindowBox" Content="按vv直接打开独立搜索窗口"
                                  Margin="20,0,0,0" VerticalAlignment="Center"
                                  Checked="VModeDirectWindowBox_Changed" Unchecked="VModeDirectWindowBox_Changed"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="导入" Click="ImportPhrases_Click"/>
                        <Button Content="导出" Margin="10,0,0,0" Click="ExportPhrases_Click"/>
                        <Button Content="清空" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="ClearPhrases_Click"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>

              <!-- 4. 剪贴板管理页面 -->
              <Grid x:Name="ClipboardPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="剪贴板" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="管理历史剪贴板记录、图文数据与自动记录开关。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <!-- 主卡片容器 -->
                <Border Grid.Row="1" Style="{StaticResource SectionStyle}" Padding="20">
                  <Grid>
                    <Grid.RowDefinitions>
                      <!-- 开关与搜索 -->
                      <RowDefinition Height="Auto"/>
                      <!-- 记录列表 -->
                      <RowDefinition Height="*"/>
                      <!-- 底部操作按钮 -->
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox x:Name="ClipboardEnabledBox" Content="启用剪贴板记录"
                                IsChecked="True" VerticalAlignment="Center"
                                Checked="ClipboardEnabledBox_Changed" Unchecked="ClipboardEnabledBox_Changed"/>
                      <Grid Grid.Column="1" Margin="24,0,0,0">
                        <TextBox x:Name="ClipboardSearchBox"
                                 Height="36" Padding="12,0,40,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="搜索剪贴板记录"
                                 TextChanged="ClipboardSearchBox_TextChanged"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                IsTabStop="False" ToolTip="搜索"
                                Click="ClipboardSearchButton_Click">
                          <Viewbox Width="15" Height="15">
                            <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 6.5,12 A 5.5,5.5 0 1 1 6.5,1 M 10.5,10.5 L 15,15"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Fill="Transparent"/>
                          </Viewbox>
                        </Button>
                      </Grid>
                    </Grid>

                    <DataGrid x:Name="ClipboardGrid" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                              Background="#FFFFFF" RowHeight="38"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="65"
                                            ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                            HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}"/>
                        <DataGridTextColumn Header="内容摘要" Binding="{Binding DisplayTitle}" Width="*"
                                            ElementStyle="{StaticResource DataGridTextStyle}"/>
                        <DataGridTemplateColumn Header="复制时间" Width="190"
                                                HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <Grid>
                                <TextBlock x:Name="TimeText" Text="{Binding FormattedTime}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <StackPanel x:Name="RowActions" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                  <Button Content="复制" Width="44" Height="24" Padding="0" FontSize="12"
                                          Style="{StaticResource ModernTextButtonStyle}"
                                          Click="RowCopy_Click" ToolTip="复制到系统剪贴板"/>
                                  <Button Content="{Binding OpenOrEditLabel}" Width="44" Height="24"
                                          Padding="0" FontSize="12" Margin="6,0,0,0"
                                          Style="{StaticResource ModernTextButtonStyle}"
                                          Click="RowOpenOrEdit_Click" ToolTip="编辑文本或打开图片、文件"/>
                                  <Button Content="删除" Width="44" Height="24" Padding="0" FontSize="12"
                                          Margin="6,0,0,0" Style="{StaticResource DangerTextButtonStyle}"
                                          Click="RowDelete_Click" ToolTip="删除此记录"/>
                                </StackPanel>
                              </Grid>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                             Value="True">
                                  <Setter TargetName="TimeText" Property="Visibility" Value="Collapsed"/>
                                  <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                             Value="True">
                                  <Setter TargetName="TimeText" Property="Visibility" Value="Collapsed"/>
                                  <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"
                                             Value="True">
                                  <Setter TargetName="TimeText" Property="Visibility" Value="Collapsed"/>
                                  <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部操作栏 -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClipboardCountText" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox x:Name="ClipboardDirectWindowBox" Content="按v直接打开独立搜索窗口"
                                  Margin="20,0,0,0" VerticalAlignment="Center"
                                  Checked="VModeDirectWindowBox_Changed" Unchecked="VModeDirectWindowBox_Changed"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="删除选中" Click="DeleteClipboardItem_Click"/>
                        <Button Content="清空记录" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="ClearClipboard_Click"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>

              <!-- 5. 词库与隐私页面 -->
              <Grid x:Name="DictionaryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="词库与隐私" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="管理自动学习词、系统词库和诊断选项。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,40,16">
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="用户学习词" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="UserDictionaryText" Style="{StaticResource SectionDescriptionStyle}"/>
                        <CheckBox x:Name="LearningBox" Content="启用用户词学习" Margin="0,16,0,16"/>
                        <WrapPanel>
                          <Button Content="导入" Click="ImportUserDictionary_Click"/>
                          <Button Content="导出" Margin="10,0,0,0" Click="ExportUserDictionary_Click"/>
                          <Button Content="打开目录" Margin="10,0,0,0" Click="OpenUserDictionary_Click"/>
                          <Button Content="清空" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="ClearUserDictionary_Click"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="系统词库" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock x:Name="PackageText" Style="{StaticResource SectionDescriptionStyle}"/>
                        <TextBox x:Name="LexiconPathBox" IsReadOnly="True" Margin="0,16,0,16"/>
                        <WrapPanel>
                          <Button Content="打开系统词库" Click="OpenLexicon_Click"/>
                          <Button Content="刷新状态" Margin="10,0,0,0" Click="Refresh_Click"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="诊断日志" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="日志可能包含输入内容，仅在排查问题时短暂开启。密码等敏感上下文不会学习。"
                                   Foreground="{StaticResource DangerBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ContentLoggingBox" Content="启用内容日志" Foreground="{StaticResource DangerBrush}"
                                  Margin="0,16,0,0"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

            </Grid>

            <!-- ================= 底部状态与操作栏 (右下 12px 圆角) ================= -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,12,0" Padding="28,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource PrimaryBrush}"
                           FontSize="12" AutomationProperties.LiveSetting="Polite"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="打开输入法安装文件夹"
                           MouseLeftButtonUp="StatusText_MouseLeftButtonUp"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="关闭" Width="88" Click="Close_Click"/>
                  <Button Content="保存设置" Width="110" Margin="12,0,0,0"
                          Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

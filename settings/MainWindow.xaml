<Window x:Class="ShuruSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发财拼音设置" Height="760" Width="820" MinHeight="620" MinWidth="700"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="发财拼音" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="隐私、模糊音、标点和用户词管理" Foreground="#666" Margin="0,4,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="隐私与学习" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="LearningBox" Content="启用用户词学习（仅写入当前用户目录）"/>
          <CheckBox x:Name="ContentLoggingBox" Margin="0,10,0,0" Content="启用内容日志（可能记录输入内容）" Foreground="#C62828" FontWeight="SemiBold"/>
          <TextBlock Text="隐私提示：内容日志默认关闭。仅排障时短暂开启，日志可能包含敏感输入。密码/敏感上下文不会学习。" Foreground="#C62828" TextWrapping="Wrap" Margin="22,5,0,0"/>
          <CheckBox x:Name="EnglishDefaultBox" Content="启动后默认英文模式" Margin="0,12,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="模糊拼音" Style="{StaticResource SectionTitle}"/>
          <CheckBox x:Name="FuzzyEnabledBox" Content="启用模糊拼音" Checked="FuzzyEnabled_Changed" Unchecked="FuzzyEnabled_Changed"/>
          <WrapPanel x:Name="FuzzyChildren" Margin="22,8,0,0">
            <CheckBox x:Name="FuzzyInitialsBox" Content="声母（zh/z、n/l 等）" Margin="0,0,22,0"/>
            <CheckBox x:Name="FuzzyFinalsBox" Content="韵母（ang/an 等）" Margin="0,0,22,0"/>
            <CheckBox x:Name="FuzzyMissingVowelBox" Content="漏元音恢复"/>
          </WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="候选与标点" Style="{StaticResource SectionTitle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="拼音方案" Width="130" VerticalAlignment="Center"/><RadioButton x:Name="QuanpinBox" Content="全拼" GroupName="InputSchema" Margin="0,0,24,0"/><RadioButton x:Name="XiaoheBox" Content="小鹤双拼" GroupName="InputSchema"/></StackPanel>
          <StackPanel Orientation="Horizontal"><TextBlock Text="中文标点策略" Width="130" VerticalAlignment="Center"/><RadioButton x:Name="FullWidthBox" Content="全角中文标点" GroupName="Punctuation" Margin="0,0,24,0"/><RadioButton x:Name="HalfWidthBox" Content="半角（交给应用）" GroupName="Punctuation"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="候选数量（3–9）" Width="130" VerticalAlignment="Center"/><TextBox x:Name="CandidateCountBox" Width="70"/></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="候选字体（14–32）" Width="130" VerticalAlignment="Center"/><TextBox x:Name="CandidateFontSizeBox" Width="70"/></StackPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="系统词库包" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="PackageText" TextWrapping="Wrap"/>
          <TextBox x:Name="LexiconPathBox" IsReadOnly="True" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}"><StackPanel>
          <TextBlock Text="用户词" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="UserDictionaryText" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <WrapPanel>
            <Button Content="导出…" Width="90" Margin="0,0,8,0" Click="ExportUserDictionary_Click"/>
            <Button Content="导入…" Width="90" Margin="0,0,8,0" Click="ImportUserDictionary_Click"/>
            <Button Content="清空…" Width="90" Margin="0,0,8,0" Click="ClearUserDictionary_Click" Foreground="#B71C1C"/>
            <Button Content="打开目录" Width="100" Click="OpenUserDictionary_Click"/>
          </WrapPanel>
        </StackPanel></Border>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#455A64" Margin="4,2,4,8"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="打开系统词库" Width="120" Margin="0,0,8,0" Click="OpenLexicon_Click"/>
      <Button Content="保存设置" Width="100" Margin="0,0,8,0" Click="Save_Click"/>
      <Button Content="刷新状态" Width="100" Margin="0,0,8,0" Click="Refresh_Click"/>
      <Button Content="关闭" Width="90" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="ShuruSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="财神输入法设置" Width="1120" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Icon="app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown">

  <!-- 外层留出 18px 留白专门渲染高级弥散阴影，保证圆角与阴影不被窗口边界裁切 -->
  <Grid Margin="18">
    <!-- 主圆角浮空卡片 -->
    <Border CornerRadius="12"
            Background="{StaticResource AppBgBrush}"
            BorderThickness="0">
      <Border.Effect>
        <DropShadowEffect Color="#0B132B" BlurRadius="24" Opacity="0.22" ShadowDepth="4" Direction="270"/>
      </Border.Effect>

      <Grid>
        <Grid.ColumnDefinitions>
          <!-- 侧边栏宽度 240px -->
          <ColumnDefinition Width="240"/>
          <!-- 主内容区 -->
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 侧边栏 (左上/左下 12px 圆角) ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                CornerRadius="12,0,0,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌标题区域 -->
            <StackPanel Margin="24,28,20,12">
              <TextBlock Text="财神输入法" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="输入法设置" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 导航菜单 -->
            <ListBox x:Name="NavigationList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="12,22,12,0" SelectedIndex="0"
                     SelectionChanged="NavigationList_SelectionChanged">
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="常规设置"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="输入方案"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="自定义短语"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="剪贴板"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="外观与皮肤"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="词库与隐私"/>
              <ListBoxItem Style="{StaticResource ModernNavListBoxItemStyle}" Content="帮助说明"/>
            </ListBox>

            <!-- 侧边栏底部版本信息 -->
            <StackPanel Grid.Row="2" Margin="20,16,20,20">
              <Border Height="1" Background="#2E3542" Margin="0,0,0,16"/>
              <TextBlock Text="2.0.1" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12"/>
              <TextBlock Text="纯净离线 · 安全高效" Foreground="{StaticResource SidebarTextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================= 主区域 (右上/右下 12px 圆角) ================= -->
        <Border Grid.Column="1" Background="{StaticResource AppBgBrush}"
                CornerRadius="0,12,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <!-- 顶部内容展示区 -->
              <RowDefinition Height="*"/>
              <!-- 底部操作与状态栏 -->
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 右上角自定义关闭按钮 -->
            <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,14,0" Panel.ZIndex="30"
                    ToolTip="关闭窗口" Click="Close_Click"/>

            <!-- 页面内容统一容器：左右留白舒适，与图2一致 -->
            <Grid Grid.Row="0" Margin="44,28,40,16">

              <!-- 1. 常规设置页面 -->
              <Grid x:Name="GeneralPage">
                <Grid.RowDefinitions>
                  <!-- 固定的页面头部：与自定义短语在同一高度 -->
                  <RowDefinition Height="Auto"/>
                  <!-- 下方卡片滚动区 -->
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="常规设置" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="调整启动状态、候选数量和中文标点。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,40,16">
                    <!-- 卡片 1: 启动与输入 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="启动与输入" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="控制输入法每次激活后的默认状态。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <CheckBox x:Name="EnglishDefaultBox" Content="启动后默认使用英文模式" Margin="0,16,0,0"/>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 2: 输入法列表名称 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock x:Name="DisplayNameLabel" Text="输入法列表名称" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="显示在 Windows 输入法切换列表中。"
                                   Style="{StaticResource SectionDescriptionStyle}"/>
                        <TextBox x:Name="DisplayNameBox" MaxLength="24" Width="320"
                                 HorizontalAlignment="Left" Margin="0,16,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DisplayNameLabel}"
                                 AutomationProperties.HelpText="输入一至二十四个可见字符"/>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 3: 候选窗口 -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="候选窗口" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="设置每页显示数量、候选字体与字号。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <WrapPanel Margin="0,16,0,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,10">
                            <TextBlock Text="候选词数量" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="CandidateCountBox" Width="96" SelectedValuePath="Content">
                              <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/>
                              <ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                              <ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/>
                            </ComboBox>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,10">
                            <TextBlock Text="候选词字体" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="CandidateFontFamilyBox" Width="168" MaxDropDownHeight="320"
                                      SelectedValuePath="Tag"/>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="候选词大小" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <ComboBox x:Name="CandidateFontSizeBox" Width="120" SelectedValuePath="Tag">
                              <ComboBoxItem Content="跟随皮肤" Tag="follow_skin"/>
                              <ComboBoxItem Content="小" Tag="small"/>
                              <ComboBoxItem Content="标准" Tag="standard"/>
                              <ComboBoxItem Content="大" Tag="large"/>
                              <ComboBoxItem Content="特大" Tag="extra_large"/>
                            </ComboBox>
                          </StackPanel>
                        </WrapPanel>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 4: 中文标点 (圆角 8px 与输入框对齐) -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="中文标点" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="选择中文模式下标点符号的输出方式。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <RadioButton x:Name="FullWidthBox" Content="中文标点（，。！）" GroupName="Punctuation"
                                       Style="{StaticResource SegmentRadioStyle}" Margin="0,0,12,0"/>
                          <RadioButton x:Name="HalfWidthBox" Content="英文标点（,.!）" GroupName="Punctuation"
                                       Style="{StaticResource SegmentRadioStyle}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- 卡片 5: 关于 (注: 保持清爽，无性能与体验卡片) -->
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="财神输入法 2.0.1 · 纯净离线 · 安全高效" Style="{StaticResource SectionDescriptionStyle}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

              <!-- 2. 输入方案页面 -->
              <Grid x:Name="InputPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="输入方案" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="选择拼音输入方式，并配置容错规则。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,40,16">
                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="拼音模式" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="更改后保存，重新切换到本输入法即可生效。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <RadioButton x:Name="QuanpinBox" Content="全拼" GroupName="InputSchema"
                                       Style="{StaticResource SegmentRadioStyle}" Margin="0,0,12,0"/>
                          <RadioButton x:Name="ShuangpinBox" Content="双拼（小鹤方案）" GroupName="InputSchema"
                                       Style="{StaticResource SegmentRadioStyle}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                      <StackPanel>
                        <TextBlock Text="模糊拼音" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="输入不准确时仍尝试恢复合理候选。" Style="{StaticResource SectionDescriptionStyle}"/>
                        <CheckBox x:Name="FuzzyEnabledBox" Content="启用模糊拼音" Margin="0,16,0,4"
                                  Checked="FuzzyEnabled_Changed" Unchecked="FuzzyEnabled_Changed"/>
                        <StackPanel x:Name="FuzzyChildren" Margin="24,10,0,0">
                          <CheckBox x:Name="FuzzyInitialsBox" Content="声母容错，例如 zh / z、n / l" Margin="0,4,0,0"/>
                          <CheckBox x:Name="FuzzyFinalsBox" Content="韵母容错，例如 ang / an" Margin="0,8,0,0"/>
                          <CheckBox x:Name="FuzzyMissingVowelBox" Content="漏元音恢复" Margin="0,8,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

              <!-- 3. 自定义短语页面 -->
              <Grid x:Name="PhrasePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="自定义短语" Style="{StaticResource PageTitleStyle}"/>
                  <TextBlock Text="让常用地址、签名或固定文本按输入码出现在指定候选位置。" Style="{StaticResource PageDescriptionStyle}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="320" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox x:Name="PhraseSearchBox" Padding="12,0,40,0"
                             VerticalContentAlignment="Center"
                             ToolTip="搜索输入码或短语"
                             TextChanged="PhraseSearchBox_TextChanged"/>
                    <Button x:Name="PhraseSearchButton"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            IsTabStop="False" ToolTip="搜索"
                            Click="PhraseSearchButton_Click">
                      <Viewbox Width="15" Height="15">
                        <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 6.5,12 A 5.5,5.5 0 1 1 6.5,1 M 10.5,10.5 L 15,15"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="Transparent"/>
                      </Viewbox>
                    </Button>
                  </Grid>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="添加短语" Style="{StaticResource PrimaryButtonStyle}" Click="AddPhrase_Click"/>
                    <Button Content="编辑" Margin="10,0,0,0" Click="EditPhrase_Click"/>
                    <Button Content="删除" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="DeletePhrase_Click"/>
                  </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PhraseGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0"
                              MouseDoubleClick="PhraseGrid_MouseDoubleClick">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="输入码" Binding="{Binding Code}" Width="150"
                                            ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                            HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}"/>
                        <DataGridTextColumn Header="候选位置" Binding="{Binding Position}" Width="110"
                                            ElementStyle="{StaticResource CenteredDataGridTextStyle}"
                                            HeaderStyle="{StaticResource CenteredDataGridColumnHeaderStyle}"/>
                        <DataGridTextColumn Header="短语内容" Binding="{Binding Phrase}" Width="*"
                                            ElementStyle="{StaticResource DataGridTextStyle}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="18,14" Background="#FFFFFF">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PhraseCountText" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <CheckBox x:Name="PhraseDirectWindowBox" Content="按vv直接打开独立搜索窗口"
                                  Margin="20,0,0,0" VerticalAlignment="Center"
                                  Checked="VModeDirectWindowBox_Changed" Unchecked="VModeDirectWindowBox_Changed"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="导入" Click="ImportPhrases_Click"/>
                        <Button Content="导出" Margin="10,0,0,0" Click="ExportPhrases_Click"/>
                        <Button Content="清空" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" Click="ClearPhrases_Click"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>

              <!-- 4. 外观与皮肤页面 -->
              <Grid x:Name="SkinPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,8,20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="外观与皮肤" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="选择精心定制的输入法皮肤与主题外观，即时生效。" Style="{StaticResource PageDescriptionStyle}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="还原默认皮肤" Click="ResetDefaultSkin_Click"/>
                    <Button Content="打开皮肤目录" Margin="10,0,0,0" Click="OpenSkinFolder_Click"/>
                    <Button Content="导入皮肤" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="ImportSkin_Click"/>
                  </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,0,-32,0" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,40,16">
                    <ItemsControl x:Name="SkinCatalogList"
                                  KeyboardNavigation.TabNavigation="Continue">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{Binding CardBackgroundBrush}"
                                  BorderBrush="{Binding CardBorderBrush}"
                                  BorderThickness="1" CornerRadius="8"
                                  Padding="20" Margin="0,0,0,16">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource PrimarySoftBrush}"
                                            BorderBrush="#C9D7FF" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2"
                                            Margin="10,0,0,0">
                                      <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                                 Foreground="#1D4ED8"
                                                 FontWeight="SemiBold"/>
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Text="{Binding AuthorLine}" FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             Margin="0,6,0,0"/>
                                  <TextBlock Text="{Binding Info}"
                                             Style="{StaticResource SectionDescriptionStyle}"/>
                                  <TextBlock Text="{Binding ValidationText}" FontSize="12"
                                             Foreground="{StaticResource DangerBrush}"
                                             Margin="0,6,0,0">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding Descriptor.IsAvailable}"
                                                       Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                  <Button Content="删除皮肤" Margin="0,0,10,0"
                                          MinWidth="100" Padding="16,10"
                                          Click="DeleteSkin_Click"
                                          AutomationProperties.Name="{Binding Name, StringFormat=删除皮肤 {0}}">
                                    <Button.Style>
                                      <Style TargetType="Button"
                                             BasedOn="{StaticResource DangerButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Button.Style>
                                  </Button>
                                  <Button Content="{Binding ActionText}"
                                          IsEnabled="{Binding CanApply}" MinWidth="120"
                                          Padding="18,10"
                                          Click="ApplySkin_Click"
                                          AutomationProperties.Name="{Binding Name}"/>
                                </StackPanel>
                              </Grid>

                              <Border Grid.Row="1" Margin="0,16,0,0"
                                      Background="{Binding PreviewBackground}"
                                      BorderThickness="0" CornerRadius="8"
                                      Padding="14,10"
                                      Width="{Binding PreviewWidth}"
                                      Height="{Binding PreviewHeight}"
                                      HorizontalAlignment="Left" ClipToBounds="True">
                                <StackPanel VerticalAlignment="Center">
                                  <Grid Margin="0,0,0,7">
                                    <TextBlock Text="cai shen"
                                               Foreground="{Binding PinyinBrush}"
                                               FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="今日 1,280 字"
                                               Foreground="{Binding StatusTextBrush}"
                                               FontSize="11" HorizontalAlignment="Right"/>
                                  </Grid>
                                  <Border Height="1" Background="{Binding SeparatorBrush}"
                                          Margin="0,0,0,8"/>
                                  <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding HighlightBackgroundBrush}"
                                            CornerRadius="6" Padding="8,4"
                                            Margin="0,0,10,0">
                                      <TextBlock Text="1.财神"
                                                 Foreground="{Binding HighlightBrush}"
                                                 FontSize="13" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="2.输入法"
                                               Foreground="{Binding CandidateBrush}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="3.发财"
                                               Foreground="{Binding CandidateBrush}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Text="4.吉祥"
                                               Foreground="{Binding CandidateBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="Collapsed">

                    <!-- 皮肤 0: 经典蓝调 (原版默认) -->
                    <Border Style="{StaticResource SectionStyle}" Padding="20">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock Text="经典蓝调" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                              <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="原版默认" FontSize="11" Foreground="#1D4ED8" FontWeight="Medium"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="原版纯净白底搭配科技亮蓝高光胶囊，经典耐看、高对比度清晰视效" Style="{StaticResource SectionDescriptionStyle}"/>
                          </StackPanel>
                          <Button x:Name="BtnSkinClassicBlue" Grid.Column="1" Content="应用此皮肤" Tag="classic_blue" MinWidth="120" Padding="18,10" VerticalAlignment="Center" Click="ApplySkin_Click"/>
                        </Grid>
                        <!-- 候选框高保真预览 (1:1 原版复刻) -->
                        <Border Grid.Row="1" Margin="0,14,0,0" Background="#FFFFFF" BorderThickness="0" CornerRadius="8" Padding="14,10" HorizontalAlignment="Left">
                          <StackPanel>
                            <Grid Margin="0,0,0,6">
                              <TextBlock Text="ddd" Foreground="#000000" FontSize="15" FontWeight="Bold"/>
                              <TextBlock Text="今日 1,280 字" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#E6E9EF" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                              <Border Background="#2F6BFF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="1.大地" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                              </Border>
                              <TextBlock Text="2.大大的" Foreground="#000000" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                              <TextBlock Text="3.单独的" Foreground="#000000" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                              <TextBlock Text="4.淡淡的" Foreground="#000000" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
